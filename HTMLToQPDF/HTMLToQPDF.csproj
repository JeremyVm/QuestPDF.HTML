<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <TargetFrameworks>net8.0;net9.0</TargetFrameworks>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
    <Title>QuestPDF.HTML</Title>
    <Company></Company>
    <Authors>Relorer, JeremyVm</Authors>
    <Description>
        QuestPDF.HTML is an extension for QuestPDF that allows to generate PDF from HTML. 
        Originally created by Relorer (https://github.com/Relorer/HTMLToQPDF).
    </Description>
    <PackageProjectUrl>https://github.com/JeremyVm/QuestPDF.HTML</PackageProjectUrl>
    <PackageIcon>icon.png</PackageIcon>
    <PackageId>QuestPDF.HTML</PackageId>
    <PackageReadmeFile>README.md</PackageReadmeFile>
    <RepositoryUrl>https://github.com/JeremyVm/QuestPDF.HTML</RepositoryUrl>
    <PackageTags>pdf, file, export, generate, generation, tool, create, creation, render, document, format, quest, html, library, converter, open, source, free, standard, core</PackageTags>
    <PackageLicenseExpression>MIT</PackageLicenseExpression>
    <!-- Kept at major.0.0.0 so consumers are not forced to rebind on every release.
         FileVersion/Version carry the real release number. -->
    <AssemblyVersion>1.0.0.0</AssemblyVersion>
    <FileVersion>1.5.1</FileVersion>
    <Version>1.5.1</Version>
    <PackageReleaseNotes>
v1.5.1:
- Fixed whitespace being dropped before inline formatting tags inside paragraphs
- Fixed inline &lt;a&gt; tags inside paragraphs rendering as plain text instead of clickable hyperlinks

For full changelog see: https://github.com/JeremyVm/QuestPDF.HTML/blob/master/CHANGELOG.md
    </PackageReleaseNotes>
  </PropertyGroup>

  <ItemGroup>
    <InternalsVisibleTo Include="HTMLToQPDF.Tests" />
  </ItemGroup>

  <ItemGroup>
    <None Include="..\README.md">
      <Pack>True</Pack>
      <PackagePath>\</PackagePath>
    </None>
  </ItemGroup>

  <!-- Declared floor for QuestPDF. NuGet treats this as a minimum, so consumers
       are free to use any newer release without waiting for a QuestPDF.HTML update.
       Only raise it when the library actually requires a newer API.
       CI overrides it to verify compatibility: -p:QuestPDFVersion=2026.8.0 -->
  <PropertyGroup>
    <QuestPDFVersion Condition="'$(QuestPDFVersion)' == ''">2025.12.3</QuestPDFVersion>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="HtmlAgilityPack" Version="1.12.4" />
    <PackageReference Include="QuestPDF" Version="$(QuestPDFVersion)" />
  </ItemGroup>

  <ItemGroup>
    <None Include="Assets\icon.png">
      <Pack>True</Pack>
      <PackagePath>\</PackagePath>
    </None>
  </ItemGroup>

</Project>
